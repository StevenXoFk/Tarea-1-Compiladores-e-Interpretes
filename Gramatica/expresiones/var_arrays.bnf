resto_id ::= [_a-zA-Z0-9]
part_id ::= [_a-zA-Z] 
id ::= (part_id resto_id*)+
coma ::= ","

tipo_var ::= "int" | "float" | "string" | "bool" | "char"
tipo_arrays ::= "int" | "float"
open_array ::= "¿:"
close_array ::= ":?"
val ::= "val"
fin_sentencia ::= "»"
asign ::= "Ͱ"
val_int_float ::= lit_int | lit_float

valores ::= val_int_float (coma val_int_float)*
var_simple ::= tipo_var id

; creacion simple de variables tipo -> val (tipo_var) id »
creacion_simple ::= val var_simple fin_sentencia

; creacion asignacion para valor tipo -> val (tipo_var) id = valor »
creacion_asign ::= val var_simple asign 